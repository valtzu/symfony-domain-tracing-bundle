{
    "name": "valtzu/domain-tracing-bundle",
    "description": "Business-level traces of PHP requests, recorded with Xdebug and described with Symfony AI",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/console": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/process": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/web-profiler-bundle": "^8.1"
    },
    "suggest": {
        "symfony/ai-claude-code-platform": "To describe the traces with the Claude Code CLI"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "escapestudios/symfony2-coding-standard": "^3.18",
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Valtzu\\DomainTracingBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Valtzu\\DomainTracingBundle\\Tests\\": "tests/"
        }
    }
}
