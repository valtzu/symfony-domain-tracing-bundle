{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% if collector.requestId %}
        {% set icon %}
            {{ source('@DomainTracing/icon.svg') }}
            <span class="sf-toolbar-label">Domain traces</span>
        {% endset %}
        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url}) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label{{ collector.requestId ? '' : ' disabled' }}">
        <span class="icon">{{ source('@DomainTracing/icon.svg') }}</span>
        <strong>Domain traces</strong>
    </span>
{% endblock %}

{% block panel %}
    {% if collector.requestId %}
        <link rel="stylesheet" href="{{ path('domain_tracing_asset', {file: 'trace.css'}) }}">
        <div id="domain-tracing"></div>
        <script type="module">
            import { followTrace } from {{ path('domain_tracing_asset', {file: 'trace.js'})|json_encode|raw }};
            followTrace({{ collector.requestId|json_encode|raw }}, document.getElementById('domain-tracing'), { describe: true });
        </script>
    {% else %}
        <h2>Domain traces</h2>
        <div class="empty"><p>This request was not recorded.</p></div>
    {% endif %}
{% endblock %}
