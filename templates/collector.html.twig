{% extends '@WebProfiler/Profiler/layout.html.twig' %}

{% block toolbar %}
    {% set icon %}
        {{ source('@DomainTracing/icon.svg') }}
        <span class="sf-toolbar-label">{{ collector.requestId ? 'Domain traces' : 'Not traced' }}</span>
    {% endset %}
    {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', {link: profiler_url, status: collector.requestId ? '' : 'yellow'}) }}
{% endblock %}

{% block menu %}
    <span class="label{{ collector.requestId ? '' : ' disabled' }}">
        <span class="icon">{{ source('@DomainTracing/icon.svg') }}</span>
        <strong>Domain traces</strong>
    </span>
{% endblock %}

{% block panel %}
    {% if collector.requestId %}
        <link rel="stylesheet" href="{{ path('domain_tracing_asset', {file: 'trace.css'}) }}">
        <div id="domain-tracing"></div>
        <script type="module">
            import { followTrace } from {{ path('domain_tracing_asset', {file: 'trace.js'})|json_encode|raw }};
            followTrace({{ collector.requestId|json_encode|raw }}, document.getElementById('domain-tracing'), { describe: true });
        </script>
    {% else %}
        <h2>Domain traces</h2>
        <div class="empty">
            <p>This request was not recorded.</p>
            {% if collector.problems %}
                <ul>
                    {% for problem in collector.problems %}<li>{{ problem }}</li>{% endfor %}
                </ul>
            {% else %}
                <p>Xdebug is set up, but the recorder did not record this request. Its output may tell why.</p>
            {% endif %}
        </div>
        {% if collector.problems %}
            <h3>Xdebug settings</h3>
            <p>Add these settings to the php.ini of the web server, and restart it. <code>bin/console domain-tracing:xdebug-settings</code> prints them too.</p>
            <pre>{{ collector.xdebugSettings }}</pre>
        {% endif %}
    {% endif %}
{% endblock %}
