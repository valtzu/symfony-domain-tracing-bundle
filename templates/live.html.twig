<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Live trace</title>
<link rel="stylesheet" href="{{ path('domain_tracing_asset', {file: 'trace.css'}) }}">
<style>
    :root { --bg: #f6f6f4; --text: #1d1d1b; --muted: #6b6b66; }
    @media (prefers-color-scheme: dark) { :root { --bg: #161615; --text: #ecece8; --muted: #9a9a94; } }
    body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, sans-serif; }
    main { max-width: 960px; margin: 0 auto; padding: 24px 16px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
    h1 { margin: 0; font-size: 22px; }
    .hint { color: var(--muted); margin: 0; }
    #traces { display: grid; gap: 16px; }
</style>
</head>
<body>
<main>
    <h1>Live trace</h1>
    <p class="hint">Each request that starts after this page opened appears here while it runs. To describe a request with AI, open its Domain traces panel in the profiler.</p>
    <div id="traces"></div>
</main>
<script type="module">
    import { followTrace } from {{ path('domain_tracing_asset', {file: 'trace.js'})|json_encode|raw }};

    const traces = document.getElementById('traces');
    let after = {{ now|json_encode|raw }};

    async function waitForNextTrace() {
        while (true) {
            const { id } = await (await fetch(`{{ path('domain_tracing_newest') }}?after=${after}`)).json();
            if (id) {
                return id;
            }
            await new Promise(resolve => setTimeout(resolve, 500));
        }
    }

    while (true) {
        const id = await waitForNextTrace();
        // A request that runs no application code, such as a 404 for a favicon, has nothing to show
        const panel = traces.insertBefore(document.createElement('section'), traces.firstChild);
        panel.hidden = true;
        await new Promise(resolve => {
            followTrace(id, panel, {
                title: null,
                onRequest: request => after = request.startedAt,
                onStep: () => panel.hidden = false,
                onDone: resolve,
            });
        });
        if (panel.hidden) {
            panel.remove();
        }
    }
</script>
</body>
</html>
