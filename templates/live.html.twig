<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Live trace</title>
<link rel="stylesheet" href="{{ path('domain_tracing_asset', {file: 'trace.css'}) }}">
<style>
    :root { --bg: #f6f6f4; --text: #1d1d1b; --muted: #6b6b66; }
    @media (prefers-color-scheme: dark) { :root { --bg: #161615; --text: #ecece8; --muted: #9a9a94; } }
    body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 system-ui, sans-serif; }
    main { max-width: 960px; margin: 0 auto; padding: 24px 16px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
    h1 { margin: 0; font-size: 22px; }
    .hint { color: var(--muted); margin: 0; }
    #traces { display: grid; gap: 16px; }
    .auto-describe { display: flex; gap: 6px; align-items: center; color: var(--muted); }
    .trace-describe { margin-top: 12px; font: inherit; font-size: 13px; padding: 4px 12px; border: 1px solid var(--trace-line); border-radius: 6px; background: transparent; color: var(--trace-text); cursor: pointer; }
    .trace-describe:hover { background: var(--trace-track); }
</style>
</head>
<body>
<main>
    <h1>Live trace</h1>
    <p class="hint">Each request that runs application code after this page opened appears here while it runs.</p>
    {% if describe %}
        <label class="auto-describe"><input type="checkbox" id="auto-describe" checked> Describe each request with AI</label>
    {% endif %}
    <div id="traces"></div>
</main>
<script type="module">
    import { followTrace, openEvents } from {{ path('domain_tracing_asset', {file: 'trace.js'})|json_encode|raw }};

    const poll = {{ poll ? 'true' : 'false' }};
    const traces = document.getElementById('traces');
    const started = [];
    let wake = () => {};
    const now = {{ now|json_encode|raw }};
    openEvents(`{{ path('domain_tracing_started') }}?after=${now}`, { poll, cursor: now }).addEventListener('trace', message => {
        started.push(JSON.parse(message.data).id);
        wake();
    });

    async function waitForNextTrace() {
        while (!started.length) {
            await new Promise(resolve => wake = resolve);
        }
        return started.shift();
    }

    // Without an AI agent, the page has no toggle and the requests are not described
    const autoDescribe = document.getElementById('auto-describe');
    try {
        autoDescribe && (autoDescribe.checked = 'off' !== localStorage.getItem('domain-tracing-auto-describe'));
    } catch {}
    autoDescribe?.addEventListener('change', () => {
        try {
            localStorage.setItem('domain-tracing-auto-describe', autoDescribe.checked ? 'on' : 'off');
        } catch {}
    });

    function follow(id, panel, describe, onEnd = () => {}) {
        followTrace(id, panel, {
            describe,
            poll,
            title: null,
            onStep: () => panel.hidden = false,
            onEnd,
            onDone: () => {
                onEnd();
                if (panel.hidden) {
                    panel.remove();
                } else if (!describe && autoDescribe) {
                    const button = panel.appendChild(document.createElement('button'));
                    button.className = 'trace-describe';
                    button.textContent = 'Describe';
                    button.addEventListener('click', () => follow(id, panel, true));
                }
            },
        });
    }

    // The next request is followed when the recording of this one ends, while its description goes on
    while (true) {
        const id = await waitForNextTrace();
        // A request that runs no application code, such as a 404 for a favicon, has nothing to show
        const panel = traces.insertBefore(document.createElement('section'), traces.firstChild);
        panel.hidden = true;
        await new Promise(resolve => follow(id, panel, autoDescribe?.checked ?? false, resolve));
    }
</script>
</body>
</html>
