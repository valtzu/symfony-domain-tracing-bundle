<!DOCTYPE html>
<html lang="en" class="trace-theme">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Domain trace</title>
<meta name="color-scheme" content="light dark">
<style>
    html { background: var(--trace-bg); }
    html.trace-resizing { overflow-y: hidden; }
    body { margin: 0; }
    {{ style|raw }}
    .trace-panel { border: 0; border-radius: 0; }
</style>
</head>
<body>
<div id="domain-tracing"></div>
<script type="module">
{{ script|raw }}

// The MCP Apps protocol (https://github.com/modelcontextprotocol/ext-apps): JSON-RPC with the host over postMessage
let lastId = 0;
const pending = new Map();
const post = message => window.parent.postMessage({ jsonrpc: '2.0', ...message }, '*');
const request = (method, params) => new Promise((resolve, reject) => {
    pending.set(++lastId, { resolve, reject });
    post({ id: lastId, method, params });
});

const panel = document.getElementById('domain-tracing');
panel.className = 'trace-panel';
panel.innerHTML = '<p class="trace-status"><span class="trace-spinner" role="status" aria-label="Loading"></span><span class="trace-status-text">Waiting for the trace…</span></p>';

let followed = null;
let source = null;
let final = false;
const follow = (trace, load) => {
    if (!trace?.id || trace.id === followed) {
        return;
    }
    source?.close();
    followed = trace.id;
    source = followTrace(trace.id, panel, { describe: trace.describe, load });
};

// The host gives the result of the tool only at its end, so meanwhile the app reads the events of the trace that the
// tool follows from the server, as the live page does. Claude Desktop lets an app read resources, but not call tools.
// Claude Desktop lets an app read only a resource that a tool declares, so the app reads all the events of the trace
// each time and skips the ones that it has, as the EventCursor of the server does: the order of each kind stays.
const AI_EVENTS = ['name', 'event', 'failure', 'done'];
const readEvents = async () => JSON.parse((await request('resources/read', { uri: '{{ events_uri }}' })).contents[0].text);
const eventsOf = id => async cursor => {
    const trace = await readEvents();
    if (null !== id && trace.id !== id) {
        return { id: null, events: [], cursor, done: false };
    }
    const [traceRead, aiRead] = `${cursor}.0`.split('.').map(Number);
    let traceCount = 0;
    let aiCount = 0;
    const events = (trace.events ?? []).filter(([type]) => AI_EVENTS.includes(type) ? ++aiCount > aiRead : ++traceCount > traceRead);
    return { ...trace, events, cursor: `${traceCount}.${aiCount}` };
};
const followWhileTheToolRuns = async () => {
    while (!followed && !final) {
        try {
            const trace = await readEvents();
            if (trace.id && !final) {
                follow(trace, eventsOf(trace.id));
            }
        } catch {
        }
        await new Promise(resolve => setTimeout(resolve, 500));
    }
};

window.addEventListener('message', ({ data }) => {
    if (data?.jsonrpc !== '2.0') {
        return;
    }
    if (undefined !== data.id && pending.has(data.id)) {
        const { resolve, reject } = pending.get(data.id);
        pending.delete(data.id);
        data.error ? reject(data.error) : resolve(data.result);
    } else if ('ui/notifications/tool-input' === data.method && 'next' === data.params?.arguments?.request && !followed) {
        panel.querySelector('.trace-status-text').textContent = 'Waiting for the next request…';
    } else if ('ui/notifications/tool-result' === data.method && data.params?._meta?.['{{ meta_key }}']?.waiting) {
        // The tool returns at once for the next request, so the app waits for it
        if (!followed) {
            panel.querySelector('.trace-status-text').textContent = 'Waiting for the next request…';
        }
    } else if ('ui/notifications/tool-result' === data.method) {
        // The result tells which trace the call followed, also when the app shows an earlier call. The tool gives the
        // trace before the AI describes it, so then the app reads the events of the AI from the server.
        final = true;
        const trace = data.params?._meta?.['{{ meta_key }}'];
        const recorded = async () => ({ events: trace.events, cursor: '', done: true });
        if (trace?.described ?? true) {
            follow(trace, recorded);
        } else {
            const events = eventsOf(trace.id);
            let polled = false;
            follow(trace, async cursor => {
                try {
                    const response = await events(cursor);
                    if (!polled && null === response.id) {
                        return recorded();
                    }
                    polled = true;
                    return response;
                } catch (error) {
                    if (polled) {
                        throw error;
                    }
                    return recorded();
                }
            });
        }
    }
});

const root = document.documentElement;
let settling;
const settle = () => {
    clearTimeout(settling);
    if (root.scrollHeight <= window.innerHeight) {
        root.classList.remove('trace-resizing');
    } else {
        settling = setTimeout(() => root.classList.remove('trace-resizing'), 500);
    }
};
window.addEventListener('resize', settle);

let size = '';
new ResizeObserver(() => {
    const height = Math.ceil(root.scrollHeight);
    if (String(height) !== size) {
        size = String(height);
        post({ method: 'ui/notifications/size-changed', params: { height } });
        if (height > window.innerHeight) {
            root.classList.add('trace-resizing');
            settle();
        }
    }
}).observe(document.body);

// The names of the fields changed while the extension was drafted, so the app sends both. The app does not wait long
// for the answer, because a host may answer only after the tool call.
const app = { name: 'domain-tracing', version: '1.0.0' };
await Promise.race([
    request('ui/initialize', { protocolVersion: '2026-01-26', appInfo: app, appCapabilities: {}, clientInfo: app, capabilities: {} }).catch(() => {}),
    new Promise(resolve => setTimeout(resolve, 1000)),
]);
post({ method: 'ui/notifications/initialized', params: {} });
followWhileTheToolRuns();
</script>
</body>
</html>
