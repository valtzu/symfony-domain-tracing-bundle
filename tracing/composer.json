{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "rybakit/msgpack": "^0.11.3",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/ai-claude-code-platform": "^1.0@beta",
        "symfony/console": "8.2.*",
        "symfony/dotenv": "8.2.*",
        "symfony/framework-bundle": "8.2.*",
        "symfony/http-client": "8.2.*",
        "symfony/runtime": "8.2.*",
        "symfony/twig-bundle": "8.2.*",
        "symfony/yaml": "8.2.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "conflict": {
        "symfony/symfony": "*"
    }
}
